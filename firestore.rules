rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }

    function isTenantOwner(tenantId) {
      return request.auth != null && request.auth.token.tenantId == tenantId;
    }

    // Marks which Auth users are platform-level super admins.
    // Only Cloud Functions (Admin SDK) can write here — never the client.
    match /superadmins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /tenants/{tenantId} {
      // Public read so the quote form can check if a restaurant is active
      // and load its branding before anyone logs in.
      allow read: if true;
      allow update: if isSuperAdmin() || isTenantOwner(tenantId);
      allow create, delete: if isSuperAdmin();

      match /menu/{itemId} {
        allow read: if true;
        allow write: if isTenantOwner(tenantId) || isSuperAdmin();
      }

      match /settings/{docId} {
        allow read: if true;
        allow write: if isTenantOwner(tenantId) || isSuperAdmin();
      }

      match /cotizaciones/{quoteId} {
        allow create: if true;
        allow read, update, delete: if isTenantOwner(tenantId) || isSuperAdmin();

        match /mensajes/{msgId} {
          allow read, write: if isTenantOwner(tenantId) || isSuperAdmin();
        }
      }
    }
  }
}
