rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Menú: cualquiera lo puede leer (para el formulario público),
    // solo la dueña autenticada lo puede editar desde el panel.
    match /menu/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Cotizaciones: cualquiera puede CREAR una (el formulario público),
    // pero solo la dueña autenticada puede leerlas, editarlas o borrarlas.
    match /cotizaciones/{quoteId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;

      // Mensajes de seguimiento por cotización
      match /mensajes/{msgId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
