rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /adjuntos/{quoteId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /branding/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
