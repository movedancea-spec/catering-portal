rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /tenants/{tenantId}/adjuntos/{quoteId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        (request.auth.token.tenantId == tenantId || request.auth.token.role == "superadmin");
    }
    match /tenants/{tenantId}/branding/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        (request.auth.token.tenantId == tenantId || request.auth.token.role == "superadmin");
    }
  }
}
